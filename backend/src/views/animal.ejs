<!-- @format -->

<!doctype html>
<html>

<head>
  <title><%- category %> - <%- animal.name %></title>
  <link href="/static/resources/main.css" rel="stylesheet" />
  <link href="/static/resources/animal.css" rel="stylesheet" />
</head>

<body>
  <div class="container">
    <div id="breadcrumbs"><%- breadcrumbs %></div>
    <script src="/static/src/breadcrumbs.js"></script>

    <img src="/static/resources/images/animals/<%- animal.image_url %>" onerror="this.onerror=null; this.src='/static/resources/images/animals/no_image.png';" class="thumbnail" />
    <h2><%- animal.name %> - <%- animal.age %>v</h2>
    <h3><%- animal.breed %></h3>
    <p><%- animal.description %></p>
    <div style="align-self:center; display:flex; gap:16px">
      <a id="reserve" class="mainlink <%= animal.status == 'reserved' ? 'disabled' : '' %>" href="./varaa">Varaa</a>
      <% if (animal.status == "reserved") { %>
      <p class="reserved">Henkilö on tällä hetkellä varannut eläimen</p>
      <% } %>
    </div>
  </div>
  <script>
    const reserve = document.getElementById("reserve");
    reserve.href = window.location.pathname + "/varaa";
  </script>
</body>

</html>