<!-- @format -->

<!doctype html>
<html>

<head>
  <title>Adoptoitavat Eläimet</title>
  <link href="/static/resources/main.css" rel="stylesheet" />
  <link href="/static/resources/animals.css" rel="stylesheet" />
</head>

<body>
  <div class="container">
    <div id="breadcrumbs"><%- breadcrumbs %></div>
    <script src="/static/src/breadcrumbs.js"></script>
    <h1><%- category %></h1>
    <main id="cards">
      <% if (animals.length == 0) { %>
      <p>Valitettavasti täältä ei löydy mitään :(</p>
      <% } %>

      <% for(let animal of animals) { %>
      <div class="card">
        <a class="link" href="<%- category %>/<%- animal.id %>"></a>
        <div class="imageHolder">
          <img src="/static/resources/images/animals/<%- animal.image_url %>" class="thumbnail" />
          <% if (animal.status == "reserved") { %>
          <h2 class="reserved">VARATTU</h2>
          <% } %>
        </div>
        <h3 class="title"><%- animal.name %> - <%- animal.age %>v</h3>
        <div class="hline"></div>
        <p class="description"><%- animal.description %></p>
        <div class="info">
          <p class="type"><%- categoryName %></p>
          <p class="breed"><%- animal.breed %></p>
        </div>
      </div>
      <% } %>
    </main>
  </div>
</body>

</html>