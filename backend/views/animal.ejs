<!-- @format -->

<!doctype html>
<html>

<head>
  <title><%= category %> - <%= name %></title>
  <link href="/static/resources/main.css" rel="stylesheet" />
  <link href="/static/resources/animal.css" rel="stylesheet" />
</head>

<body>
  <div class="container">
    <div id="breadcrumbs"><%- breadcrumbs %></div>
    <script src="/static/src/breadcrumbs.js"></script>

    <img src="/static/resources/images/animals/<%= name %>.jpg" onerror="this.onerror=null; this.src='/static/resources/images/no_image.png';" class="thumbnail"/>
    <h2><%= name %></h2>
    <h3><%= breed %></h3>
    <p><%= description %></p>
    <a id="reserve" style="align-self:center" class="mainlink" href="./varaa">Varaa</a>
  </div>
  <script>
    const reserve = document.getElementById("reserve");
    reserve.href = window.location.pathname + "/varaa";
  </script>
</body>

</html>