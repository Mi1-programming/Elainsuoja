
<!-- @format -->

<!doctype html>
<html lang="fi">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Adoptiohakemus: <%= name %></title>

    <link href="/static/resources/main.css" rel="stylesheet" />

    <style>
        .reservation-card {
            max-width: 600px;
            margin: 30px auto;
            padding: 28px;
            background: #fff5f8;
            border: 1px solid #e4b4cb;
            border-radius: 16px;
            box-sizing: border-box;
        }

        .reservation-card h1 {
            margin-top: 0;
            line-height: 1.25;
        }

        .reservation-intro {
            line-height: 1.6;
            margin-bottom: 24px;
        }

        .form-group {
            margin-bottom: 18px;
        }

        .form-group label {
            display: block;
            margin-bottom: 7px;
            font-weight: bold;
        }

        .form-group input,
        .form-group textarea {
            display: block;
            width: 100%;
            box-sizing: border-box;
            padding: 11px 12px;
            border: 1px solid #cda6bb;
            border-radius: 7px;
            background: #fff;
            font: inherit;
        }

        .form-group input:focus,
        .form-group textarea:focus {
            outline: 2px solid #bd4387;
            outline-offset: 2px;
        }

        .form-group textarea {
            min-height: 120px;
            resize: vertical;
        }

        .submit-button {
            display: block;
            width: 100%;
            padding: 13px;
            background: #b9437e;
            color: white;
            border: none;
            border-radius: 8px;
            font: inherit;
            font-weight: bold;
            cursor: pointer;
        }

        .submit-button:hover {
            background: #963363;
        }

        .submit-button:disabled {
            opacity: 0.6;
            cursor: wait;
        }

        .form-message {
            margin-top: 18px;
            line-height: 1.6;
            overflow-wrap: anywhere;
        }

        .success-message {
            padding: 18px;
            background: #edf8ed;
            border: 1px solid #8bb98b;
            border-radius: 8px;
        }

        .error-message {
            padding: 14px;
            background: #fff0f0;
            border: 1px solid #d88b8b;
            border-radius: 8px;
            color: #7d2020;
        }

        .back-link {
            display: inline-block;
            margin-top: 20px;
        }

        @media (max-width: 640px) {
            .reservation-card {
                margin: 16px 8px;
                padding: 20px;
            }
        }
    </style>
</head>

<body>
    <div class="container">
        <div id="breadcrumbs"><%- breadcrumbs %></div>
        <script src="/static/src/breadcrumbs.js"></script>

        <main class="reservation-card">
            <h1>Adoptiohakemus: <%= name %></h1>

            <p class="reservation-intro">
                Haluatko tarjota <strong><%= name %></strong>-kissalle
                uuden kodin? Täytä alla oleva hakemus.
                Eläinsuoja ottaa sinuun yhteyttä hakemuksen käsittelyn jälkeen.
            </p>

            <form id="reservation-form">
                <div class="form-group">
                    <label for="applicant_name">Koko nimi *</label>
                    <input
                        id="applicant_name"
                        name="applicant_name"
                        type="text"
                        maxlength="150"
                        autocomplete="name"
                        required
                    />
                </div>

                <div class="form-group">
                    <label for="email">Sähköpostiosoite *</label>
                    <input
                        id="email"
                        name="email"
                        type="email"
                        maxlength="254"
                        autocomplete="email"
                        required
                    />
                </div>

                <div class="form-group">
                    <label for="phone">Puhelinnumero *</label>
                    <input
                        id="phone"
                        name="phone"
                        type="tel"
                        maxlength="30"
                        autocomplete="tel"
                        required
                    />
                </div>

                <div class="form-group">
                    <label for="message">Lisätiedot</label>
                    <textarea
                        id="message"
                        name="message"
                        maxlength="3000"
                        placeholder="Kerro esimerkiksi kodistasi ja siitä, miksi haluaisit adoptoida tämän kissan."
                    ></textarea>
                </div>

                <button
                    class="submit-button"
                    id="submit-button"
                    type="submit"
                >
                    Lähetä adoptiohakemus
                </button>
            </form>

            <!-- Tärkeää: tämä on lomakkeen ULKOPUOLELLA. -->
            <!-- Näin viesti pysyy näkyvissä, kun lomake piilotetaan. -->
            <p
                id="form-message"
                class="form-message"
                role="status"
                aria-live="polite"
                hidden
            ></p>

            <a
                class="back-link"
                id="back-link"
                href="/koti"
            >
                ← Takaisin eläinten listaan
            </a>
        </main>
    </div>

    <script>
        const animalId = <%- JSON.stringify(animalId) %>;
        const animalName = <%- JSON.stringify(name) %>;

        const form = document.getElementById("reservation-form");
        const button = document.getElementById("submit-button");
        const message = document.getElementById("form-message");
        const backLink = document.getElementById("back-link");

        form.addEventListener("submit", async (event) => {
            event.preventDefault();

            if (!form.reportValidity()) {
                return;
            }

            const data = new FormData(form);

            const application = {
                applicant_name: data.get("applicant_name").trim(),
                email: data.get("email").trim(),
                phone: data.get("phone").trim(),
                message: data.get("message").trim()
            };

            button.disabled = true;
            button.textContent = "Lähetetään...";

            message.hidden = false;
            message.className = "form-message";
            message.textContent = "Hakemusta lähetetään...";

            try {
                const response = await fetch(
                    `/animals/${encodeURIComponent(animalId)}/adopt`,
                    {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify(application)
                    }
                );

                const result = await response.json().catch(() => ({}));

                if (!response.ok) {
                    throw new Error(
                        result.error ||
                        result.message ||
                        "Hakemuksen lähettäminen epäonnistui."
                    );
                }

                // Piilotetaan lomake, mutta ei viestielementtiä.
                form.hidden = true;

                message.className =
                    "form-message success-message";

                message.textContent =
                    `Kiitos! Adoptiohakemuksesi kissasta ${animalName} ` +
                    "on vastaanotettu ja tallennettu. " +
                    "Eläinsuoja ottaa sinuun yhteyttä.";

                button.textContent = "Hakemus lähetetty";
                backLink.href = "/koti";
                backLink.textContent = "← Takaisin etusivulle";

            } catch (error) {
                // Virhe näytetään lomakkeen yläpuolella
                // tai alapuolella, mutta lomake säilyy käytössä.
                message.hidden = false;
                message.className =
                    "form-message error-message";

                message.textContent =
                    error.message ||
                    "Yhteys palvelimeen epäonnistui. Yritä uudelleen.";

                button.disabled = false;
                button.textContent = "Lähetä adoptiohakemus";
            }
        });
    </script>
</body>

</html>
